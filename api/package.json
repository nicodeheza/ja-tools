{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "tsc && NODE_ENV=production node --env-file=.env ./dist/index ",
    "dev": "tsc -w & node --env-file=.env --watch ./dist/index",
    "dict:setup": "tsc && node ./dist/dict/setup/setupDict",
    "dict:push": "drizzle-kit push --config drizzle.config.dict.ts",
    "dict:upload": "tsc && node --env-file=.env ./dist/scripts/dict/uploadDict",
    "dict:download": "tsc && node --env-file=.env ./dist/scripts/dict/downloadDict",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && prettier --check . && eslint .",
    "build": "tsc"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/lib-storage": "^3.1063.0",
    "@eslint/js": "^9.25.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.2",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.3",
    "saxes": "^6.0.0",
    "supertest": "^7.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@enjoyjs/node-mecab": "^0.5.0",
    "@google/genai": "^1.0.0",
    "@ja-tools/share-types": "workspace:*",
    "better-sqlite3": "^12.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "wanakana": "^5.3.1"
  }
}
